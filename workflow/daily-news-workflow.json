    {
      "parameters": {
        "jsCode": "// ============================================================\n// 每日新闻 - 飞书卡片（方案 B 紧凑列表）生成 + 直接发送\n// 用法：全选复制本文件全部内容 → 粘贴到 n8n Code 节点\n//       （模式：Run Once for All Items / 所有项运行）\n// 位置：Edit Fields4 → Bitable → 本节点\n// 依赖字段：新闻标题、内容、传达消息、媒体、链接、发布时间\n// ============================================================\n\nconst items = $('Edit Fields4').all();\n\nconst fmtTime = s => s\n  ? new Date(s).toLocaleString(\"zh-CN\", { timeZone: \"Asia/Shanghai\", month: \"2-digit\", day: \"2-digit\", hour: \"2-digit\", minute: \"2-digit\" })\n  : \"\";\n\n// ---- 按媒体轮询交错：IT之家1条→36氪1条→少数派1条→爱范儿1条→循环 ----\n// 保证前 10 条里四家媒体都能露出，避免更新最快的源独占版面\nconst groups = {};\nfor (const it of items) {\n  const m = it.json.媒体 || \"其他\";\n  (groups[m] = groups[m] || []).push(it);\n}\nconst interleaved = [];\nlet added = true;\nwhile (added) {\n  added = false;\n  for (const m of Object.keys(groups)) {\n    if (groups[m].length) { interleaved.push(groups[m].shift()); added = true; }\n  }\n}\nconst selected = interleaved.slice(0, 10);\n\nconst news = selected.map((i, idx) => {\n  const j = i.json;\n  const msg = j.传达消息 ? \"\\n📣 **传达：**\" + j.传达消息 : \"\";\n  const meta = \"🗞 \" + (j.媒体 || \"\") + \" · 🕒 \" + fmtTime(j.发布时间) + (j.链接 ? \" · [原文](\" + j.链接 + \")\" : \"\");\n  return {\n    tag: \"div\",\n    text: {\n      tag: \"lark_md\",\n      content: \"**\" + (idx + 1) + \". \" + (j.新闻标题 || \"无标题\") + \"**\\n\" + (j.内容 || \"\") + msg + \"\\n\" + meta\n    }\n  };\n});\n\nconst card = {\n  config: { wide_screen_mode: true, enable_forward: true },\n  header: {\n    template: \"wathet\",\n    title: { tag: \"plain_text\", content: \"📰 每日科技新闻速递\" },\n    subtitle: { tag: \"plain_text\", content: \"IT之家 · 36氪快讯 · 少数派 · 爱范儿\" }\n  },\n  elements: [\n    {\n      tag: \"div\",\n      text: {\n        tag: \"lark_md\",\n        content: \"✨ 今日共 **\" + items.length + \"** 条科技资讯 · \" + new Date().toLocaleDateString(\"zh-CN\", { timeZone: \"Asia/Shanghai\" })\n      }\n    },\n    { tag: \"hr\" }\n  ].concat(news).concat([\n    { tag: \"hr\" },\n    {\n      tag: \"action\",\n      actions: [\n        {\n          tag: \"button\",\n          text: { tag: \"plain_text\", content: \"查看全部 \" + items.length + \" 条\" },\n          type: \"primary\",\n          url: \"https://<YOUR_TENANT>.feishu.cn/base/<YOUR_BITABLE_APP_TOKEN>?table=<YOUR_BITABLE_TABLE_ID>\"\n        }\n      ]\n    },\n    {\n      tag: \"note\",\n      elements: [{ tag: \"plain_text\", content: \"RSS 工作流自动推送 · 早 8:00 / 晚 20:00 · 仅展示最新 10 条\" }]\n    }\n  ])\n};\n\n// ---- 直接发送给飞书群机器人 ----\nconst WEBHOOK = \"https://open.feishu.cn/open-apis/bot/v2/hook/<YOUR_FEISHU_WEBHOOK_TOKEN>\";\n\nconst resp = await this.helpers.httpRequest({\n  method: \"POST\",\n  url: WEBHOOK,\n  body: { msg_type: \"interactive\", card: card },\n  headers: { \"Content-Type\": \"application/json\" },\n  json: true\n});\n\n// resp 应为 { code: 0, msg: \"success\" }；非 0 时原始回执会带出来便于排查\nreturn [{ json: { feishu_response: resp, 推送条数: items.length, 展示条数: selected.length } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
