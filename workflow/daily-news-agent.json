      ],
      "id": "c7c6e3d0-e837-4076-b51f-d51882e3da96",
      "name": "DeepSeek Chat Model"
    },
    {
      "parameters": {
        "resource": "bitable",
        "operation": "bitable:table:record:search",
        "app_toke": "<YOUR_BITABLE_APP_TOKEN>",
        "table_id": "<YOUR_BITABLE_TABLE_ID>",
        "body": "={\n  \"filter\": {\n    \"conjunction\": \"or\",\n    \"conditions\": [\n      {\n        \"field_name\": \"创建时间\",\n        \"operator\": \"is\",\n        \"value\": [\"Today\"]\n      },\n      {\n        \"field_name\": \"创建时间\",\n        \"operator\": \"is\",\n        \"value\": [\"Yesterday\"]\n      }\n    ]\n  }\n}"
      },
